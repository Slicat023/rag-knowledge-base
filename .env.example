# ============================================================
# 知库 RAG — 环境配置
# 复制本文件为 .env，然后填写你自己的 API Key
# ============================================================

# ---------- 大模型（二选一或都填） ----------
# 通义千问 / DashScope（也兼容 DASHSCOPE_API_KEY 这个变量名）
QWEN_API_KEY=
# 只用 DASHSCOPE_API_KEY 时填这里（QWEN_API_KEY 留空即可）
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 前端默认选中的模型：qwen 或 deepseek
DEFAULT_LLM=qwen

# ---------- 本地模型 ----------
# 先运行 python scripts/download_models.py 下载到这两个目录
EMBEDDING_MODEL=models/bge-base-zh-v1.5
RERANKER_MODEL=models/bge-reranker-base

# auto / cpu / cuda / cuda:0
EMBEDDING_DEVICE=auto
RERANK_DEVICE=auto

# 有 GPU 时可适当调大
EMBEDDING_BATCH_SIZE=16
RERANKER_BATCH_SIZE=8

# ---------- 检索参数 ----------
RETRIEVAL_TOP_K=12
RERANKER_TOP_N=6
RERANK_ENABLED=true
CHUNK_SIZE=420
CHUNK_OVERLAP=60
# 参与 embedding 的最近章节层数（完整路径仍保存在 metadata）
EMBED_CONTEXT_LEVELS=3

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000
DEBUG=false
MAX_UPLOAD_MB=50

# 首次启动后在后台预热模型（关闭可加快启动）
WARMUP_MODELS=true

# HuggingFace 镜像（仅在使用 HF 仓库 id 时生效）
HF_ENDPOINT=https://hf-mirror.com